<?php
/**
 * @var \Zip\ZipPayment\Block\Advert\RootEl $block
 * @var \Magento\Framework\Escaper $escaper
 * @var \Magento\Framework\View\Helper\SecureHtmlRenderer $secureRenderer
 */

$widgetJs = "\n"
    . "    zip_widget_merchantId = '" . $escaper->escapeJs((string)$block->getMerchantPublicKey()) . "';\n"
    . "    zip_widget_env = '" . $escaper->escapeJs((string)$block->getEnvironment()) . "';\n"
    . "    zip_widget_region = '" . $escaper->escapeJs(strtolower((string)$block->getRegion())) . "';\n"
    . "    zip_widget_max_price = '" . $escaper->escapeJs((string)$block->getOrderTotalMaximum()) . "';\n"
    . "    zip_widget_min_price = '" . $escaper->escapeJs((string)$block->getOrderTotalMinimum()) . "';\n"
    . "    zip_widget_display_inline = '" . $escaper->escapeJs((string)$block->isDisplayInlineWidget()) . "';\n"
    . "    zip_widget_language = '" . $escaper->escapeJs(strtolower((string)$block->getLanguageCode())) . "';\n";
if ($block->getPageType() == 'cart') {
    $widgetJs .= "    zip_widget_cart_price = " . (float)$block->getCartTotal() . ";\n";
}
if ($block->getPageType() == 'product') {
    $widgetJs .= "    zip_widget_product_price = " . (float)$block->getProductPrice() . ";\n";
}
foreach ($block->getElementSelectors() as $key => $selector) {
    if (!empty($selector)) {
        $widgetJs .= "    zip_widget_" . preg_replace('/[^A-Za-z0-9_]/', '', (string)$key)
            . " = \"" . $escaper->escapeJs((string)$selector) . "\";\n";
    }
}
?>
<script src="https://static.zip.co/lib/js/zm-widget-js/dist/zip-widget.min.js"></script>
<?= /* @noEscape */ $secureRenderer->renderTag('script', [], $widgetJs, false) ?>

<?php
$viewModel = $block->getWidgetConfigViewModel();
if ($viewModel):
    ?>
<script type="text/x-magento-init">
{
    "*": {
        "Zip_ZipPayment/js/widget-config": <?= /* @noEscape */ $viewModel->getWidgetConfigJson() ?>
    }
}
</script>
<?php endif; ?>
